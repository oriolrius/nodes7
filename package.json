{
  "name": "@oriolrius/nodes7",
  "description": "A javascript library to communicate with Siemens S7 PLCs (fork of @st-one-io/nodes7 with the S7comm fill-byte fixes)",
  "version": "1.1.5",
  "author": "Guilherme Francescon <guilherme@st-one.io>",
  "contributors": [
    "Oriol Rius <oriol@joor.net>"
  ],
  "keywords": [
    "S7",
    "Siemens",
    "PLC",
    "RFC1006",
    "iso-on-tcp",
    "mpi",
    "s7-200",
    "s7-300",
    "s7-400",
    "s7-1200",
    "s7-1500",
    "profinet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oriolrius/nodes7.git"
  },
  "bugs": {
    "url": "https://github.com/oriolrius/nodes7/issues"
  },
  "homepage": "https://github.com/oriolrius/nodes7#readme",
  "main": "src/index.js",
  "files": [
    "src",
    "legacy.js"
  ],
  "scripts": {
    "test": "nyc --reporter=html --reporter=text --reporter=text-summary mocha --require test/setup.js --timeout=3000 test/**/**.spec.js",
    "doc": "jsdoc2md --files src/**.js > doc/API.md",
    "test:integration": "mocha --timeout=60000 test/integration/*.integration.js"
  },
  "engine": {
    "node": ">= 10.0.0"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "chai": "^4.2.0",
    "jsdoc-to-markdown": "^6.0.1",
    "mocha": "^8.1.3",
    "nyc": "^15.1.0"
  },
  "dependencies": {
    "iso-on-tcp": "^0.1.0"
  }
}
